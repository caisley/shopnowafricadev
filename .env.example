# Copy configuration/config.example.php to config/config.php and replace placeholders.
# This file is documentation only; do not commit production secrets.
SNA_SITE_URL=https://shopnowafrica.com
SNA_NOTIFY_EMAIL=REPLACE_WITH_RFP_NOTIFICATION_EMAIL
SNA_FROM_EMAIL=REPLACE_WITH_VERIFIED_FROM_EMAIL
SNA_MAIL_ENABLED=false
SNA_STORAGE_PATH=/home/ACCOUNT/private/sna-storage
# If a database is added later, keep its credentials outside public_html.
DB_HOST=REPLACE_IF_DATABASE_IS_ENABLED
DB_NAME=REPLACE_IF_DATABASE_IS_ENABLED
DB_USER=REPLACE_IF_DATABASE_IS_ENABLED
DB_PASSWORD=REPLACE_IF_DATABASE_IS_ENABLED
